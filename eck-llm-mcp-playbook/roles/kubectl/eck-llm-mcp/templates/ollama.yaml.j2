apiVersion: apps/v1
kind: Deployment
metadata:
  name: ollama
  namespace: {{ ai_namespace }}
spec:
  replicas: 1
  # RWO 本地 PV + 32Gi 記憶體：新舊 pod 不可同時存在
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: ollama
  template:
    metadata:
      labels:
        app: ollama
    spec:
      tolerations:
{{ ai_tolerations | to_nice_yaml | trim | indent(8, true) }}
      nodeSelector:
        {{ ai_node_label_key }}: "{{ ai_node_label_value }}"
{% if image_pull_secrets | length > 0 %}
      imagePullSecrets:
{% for s in image_pull_secrets %}
        - name: {{ s }}
{% endfor %}
{% endif %}
      containers:
        - name: ollama
          image: {{ ollama_image }}
          ports:
            - containerPort: {{ ollama_service_port }}
          env:
            - name: OLLAMA_HOST
              value: "0.0.0.0"
            - name: OLLAMA_KEEP_ALIVE
              value: "{{ ollama_keep_alive }}"
            - name: OLLAMA_NUM_PARALLEL
              value: "{{ ollama_num_parallel }}"
            - name: OLLAMA_CONTEXT_LENGTH
              value: "{{ ollama_context_length }}"
            - name: OLLAMA_MAX_LOADED_MODELS
              value: "{{ ollama_max_loaded_models }}"
          readinessProbe:
            httpGet:
              path: /api/version
              port: {{ ollama_service_port }}
            periodSeconds: 5
            failureThreshold: 12
          resources:
            requests:
              memory: "{{ ollama_resources_requests_memory }}"
              cpu: "{{ ollama_resources_requests_cpu }}"
            limits:
              memory: "{{ ollama_resources_limits_memory }}"
          volumeMounts:
            - name: models
              mountPath: /root/.ollama
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: ollama-models
---
apiVersion: v1
kind: Service
metadata:
  name: ollama
  namespace: {{ ai_namespace }}
spec:
  selector:
    app: ollama
  ports:
    - port: {{ ollama_service_port }}
      targetPort: {{ ollama_service_port }}
