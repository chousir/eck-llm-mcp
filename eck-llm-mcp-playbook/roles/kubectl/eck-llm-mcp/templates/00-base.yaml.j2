# namespace + 本地 PV/PVC（PV/PVC 容量建立後不可變更，要改須先刪除重建）
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ai_namespace }}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ollama-models
spec:
  capacity: { storage: 60Gi }
  accessModes: ["ReadWriteOnce"]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  local:
    path: {{ ollama_pv_path }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - { key: kubernetes.io/hostname, operator: In, values: ["{{ ai_node_name }}"] }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ollama-models
  namespace: {{ ai_namespace }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: ""
  volumeName: ollama-models
  resources:
    requests: { storage: 60Gi }
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: openwebui-data
spec:
  capacity: { storage: 10Gi }
  accessModes: ["ReadWriteOnce"]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  local:
    path: {{ openwebui_pv_path }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - { key: kubernetes.io/hostname, operator: In, values: ["{{ ai_node_name }}"] }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: openwebui-data
  namespace: {{ ai_namespace }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: ""
  volumeName: openwebui-data
  resources:
    requests: { storage: 10Gi }
