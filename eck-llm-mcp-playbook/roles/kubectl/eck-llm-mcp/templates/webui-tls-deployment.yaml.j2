# Open WebUI + nginx sidecar (terminates TLS); the certificate is issued by cert-manager's {{ cert_issuer_name }} with the Service IP as SAN
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: open-webui-tls
  namespace: {{ ai_namespace }}
spec:
  secretName: open-webui-tls
  issuerRef: { name: {{ cert_issuer_name }}, kind: ClusterIssuer }
  ipAddresses: ["{{ webui_vip }}"]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: open-webui-nginx
  namespace: {{ ai_namespace }}
data:
  nginx.conf: |
    events {}
    http {
      map $http_upgrade $connection_upgrade { default upgrade; '' close; }
      server {
        listen 8443 ssl;
        ssl_certificate     /etc/nginx-tls/tls.crt;
        ssl_certificate_key /etc/nginx-tls/tls.key;
        client_max_body_size 512m;               # knowledge-base file uploads
        location / {
          proxy_pass http://127.0.0.1:8080;
          proxy_http_version 1.1;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header Upgrade $http_upgrade;     # WebSocket
          proxy_set_header Connection $connection_upgrade;
          proxy_buffering off;                        # streaming responses
          proxy_read_timeout 3600s;
          proxy_send_timeout 3600s;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: open-webui
  namespace: {{ ai_namespace }}
spec:
  replicas: 1
  strategy: { type: Recreate }        # SQLite on an RWO local PV: two pods must never write at the same time
  selector:
    matchLabels: { app: open-webui }
  template:
    metadata:
      labels: { app: open-webui }
      annotations:
        # Roll the pod when the Service IP changes (Service recreated) so nginx loads the new certificate
        eck-llm-mcp/vip: "{{ webui_vip }}"
    spec:
      tolerations:
        - { key: node-role.kubernetes.io/control-plane, effect: NoSchedule }
      nodeSelector:
        kubernetes.io/hostname: {{ inventory_hostname }}
      containers:
        - name: open-webui
          image: {{ open_webui_image }}
          ports:
            - containerPort: 8080
          env:
            - { name: WEBUI_AUTH, value: "true" }
            # On first start (no users in the DB) create the admin automatically and disable open sign-up
            - { name: WEBUI_ADMIN_EMAIL, value: admin@example.com }
            - { name: WEBUI_ADMIN_NAME, value: Admin }
            - { name: ENABLE_SIGNUP, value: "false" }
            - name: WEBUI_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef: { name: open-webui-secret, key: WEBUI_ADMIN_PASSWORD }
            - name: WEBUI_SECRET_KEY
              valueFrom:
                secretKeyRef: { name: open-webui-secret, key: WEBUI_SECRET_KEY }
            - { name: WEBUI_SESSION_COOKIE_SECURE, value: "true" }
            - { name: WEBUI_AUTH_COOKIE_SECURE, value: "true" }
            # air-gap: no outbound calls, don't wait for api.openai.com to time out
            - { name: OFFLINE_MODE, value: "true" }
            - { name: ENABLE_OPENAI_API, value: "false" }
            - { name: ENABLE_COMMUNITY_SHARING, value: "false" }
            - { name: OLLAMA_BASE_URL, value: "{{ ollama_url }}" }
            - { name: DEFAULT_MODELS, value: "{{ ollama_primary_model }}" }
            - { name: BYPASS_MODEL_ACCESS_CONTROL, value: "true" }   # only local models exist, visible to all users
            - name: DEFAULT_MODEL_PARAMS
              value: {{ webui_default_model_params | to_json | to_json }}
            # Written to the DB on first start; change it later under Admin -> Settings -> Integrations
            - name: TOOL_SERVER_CONNECTIONS
              value: {{ webui_tool_server_connections | to_json | to_json }}
            - { name: RAG_EMBEDDING_ENGINE, value: ollama }
            - { name: RAG_EMBEDDING_MODEL, value: "{{ ollama_embed_model }}" }
            - { name: RAG_OLLAMA_BASE_URL, value: "{{ ollama_url }}" }
          startupProbe:
            httpGet: { path: /health, port: 8080 }
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /health, port: 8080 }
            periodSeconds: 10
          resources:
            requests: { memory: 2Gi, cpu: "1" }
            limits: { memory: 4Gi }
          volumeMounts:
            - { name: data, mountPath: /app/backend/data }
        - name: nginx-tls
          image: {{ nginx_image }}
          # nginx does not notice when cert-manager renews the Secret, so reload it every 6 hours;
          # if nginx itself exits the loop ends too and the container restarts.
          command:
            - /bin/sh
            - -c
            - |
              nginx -g 'daemon off;' &
              pid=$!
              trap 'nginx -s quit; wait "$pid"; exit 0' TERM INT QUIT   # the nginx image's STOPSIGNAL is SIGQUIT
              while kill -0 "$pid" 2>/dev/null; do
                sleep 21600 & wait $!
                nginx -s reload
              done
              wait "$pid"
          ports:
            - containerPort: 8443
          readinessProbe:
            tcpSocket: { port: 8443 }
            periodSeconds: 5
          volumeMounts:
            - { name: nginx-config, mountPath: /etc/nginx/nginx.conf, subPath: nginx.conf, readOnly: true }
            - { name: tls-cert, mountPath: /etc/nginx-tls, readOnly: true }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: openwebui-data }
        - name: nginx-config
          configMap: { name: open-webui-nginx }
        - name: tls-cert
          secret: { secretName: open-webui-tls }
