#!/bin/sh
# 在 open-webui pod 內執行（kubectl exec -i deploy/open-webui -- sh -s），
# 走的網路路徑與實際運作時相同。任何一項失敗 -> 結尾 exit 1。
FAIL=0
ok()   { echo "  [PASS] $*"; }
bad()  { echo "  [FAIL] $*"; FAIL=1; }
warn() { echo "  [WARN] $*"; }

OLLAMA="{{ ollama_url }}"
MCP="{{ es_mcp_url }}"
MCP_BASE="http://es-mcp.{{ ai_namespace }}.svc:8080"
PRIMARY="{{ ollama_primary_model }}"

# ---- MCP streamable HTTP：回應可能是 JSON 或 SSE（data: {...}） ----
HDR=/tmp/mcp.hdr
SID=""
mcp() {  # $1 = JSON-RPC body；輸出回應 JSON
  if [ -n "$SID" ]; then
    out=$(curl -s -m 30 -D "$HDR" -X POST "$MCP" -H 'Content-Type: application/json' \
      -H 'Accept: application/json, text/event-stream' -H "Mcp-Session-Id: $SID" -d "$1")
  else
    out=$(curl -s -m 30 -D "$HDR" -X POST "$MCP" -H 'Content-Type: application/json' \
      -H 'Accept: application/json, text/event-stream' -d "$1")
  fi
  sse=$(printf '%s\n' "$out" | sed -n 's/^data: *//p')
  if [ -n "$sse" ]; then printf '%s\n' "$sse"; else printf '%s\n' "$out"; fi
}

echo "1) Open WebUI -> Ollama：模型清單"
TAGS=$(curl -s -m 20 "$OLLAMA/api/tags")
if [ -z "$TAGS" ]; then bad "連不到 $OLLAMA/api/tags"; else
{% for m in ollama_models %}
  echo "$TAGS" | jq -re '.models[].name' | grep -qFx "{{ m }}" \
    && ok "{{ m }}" || bad "Ollama 沒有模型 {{ m }}"
{% endfor %}
fi

echo "2) Ollama tool_calls（$PRIMARY）"
REQ=$(jq -n --arg m "$PRIMARY" '{model:$m,stream:false,
  messages:[{role:"user",content:"What is the weather in Taipei? Use the tool."}],
  tools:[{type:"function",function:{name:"get_weather",description:"Get current weather for a city",
    parameters:{type:"object",properties:{city:{type:"string"}},required:["city"]}}}]}')
RES=$(curl -s -m 900 "$OLLAMA/api/chat" -d "$REQ")
if echo "$RES" | jq -e '(.message.tool_calls | length) > 0' >/dev/null 2>&1; then
  ok "模型回傳 tool_calls"
else
  bad "模型沒有回傳 tool_calls（檢查 ollama_context_length、模型是否支援工具呼叫）：$(echo "$RES" | head -c 300)"
fi

echo "3) Open WebUI -> es-mcp"
[ "$(curl -s -m 10 "$MCP_BASE/ping")" ] && ok "/ping 有回應" || bad "$MCP_BASE/ping 無回應"
INIT=$(mcp '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"smoke","version":"1"}}}')
SID=$(sed -n 's/^[Mm][Cc][Pp]-[Ss]ession-[Ii]d: *//p' "$HDR" | tr -d '\r')
if echo "$INIT" | jq -e '.result.serverInfo' >/dev/null 2>&1; then ok "MCP initialize"; else bad "MCP initialize 失敗：$(echo "$INIT" | head -c 300)"; fi
mcp '{"jsonrpc":"2.0","method":"notifications/initialized"}' >/dev/null
LIST=$(mcp '{"jsonrpc":"2.0","id":2,"method":"tools/list"}')
NAMES=$(echo "$LIST" | jq -r '.result.tools[]?.name' 2>/dev/null | tr '\n' ' ')
case "$NAMES" in
  *list_indices*search*|*search*list_indices*) ok "tools/list：$NAMES" ;;
  *) bad "tools/list 沒有預期的工具：${NAMES:-$(echo "$LIST" | head -c 300)}" ;;
esac

echo "4) es-mcp -> Elasticsearch（mcp_user 帳密與權限）"
CALL=$(mcp '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"list_indices","arguments":{"index_pattern":"*"}}}')
if echo "$CALL" | jq -e '.result and ((.result.isError // false) | not) and (has("error") | not)' >/dev/null 2>&1; then
  ok "list_indices 成功"
else
  bad "list_indices 失敗（403 = 帳號/角色，連線錯誤 = ES_URL/憑證）：$(echo "$CALL" | head -c 400)"
fi

echo "5) Open WebUI：es-mcp 已註冊"
TOKEN=$(curl -s -m 20 http://127.0.0.1:8080/api/v1/auths/signin \
  -H 'Content-Type: application/json' \
  -d "$(jq -n --arg e "$WEBUI_ADMIN_EMAIL" --arg p "$WEBUI_ADMIN_PASSWORD" '{email:$e,password:$p}')" | jq -r '.token // empty')
if [ -z "$TOKEN" ]; then
  warn "admin 登入失敗（密碼可能已在 UI 改過），略過此項"
else
  CFG=$(curl -s -m 20 -H "Authorization: Bearer $TOKEN" http://127.0.0.1:8080/api/v1/configs/tool_servers)
  echo "$CFG" | grep -q "es-mcp" && ok "tool_servers 內有 es-mcp" \
    || bad "tool_servers 沒有 es-mcp（DB 內已有舊設定時 env 不會覆蓋，請到 Admin -> Settings -> Integrations 新增）"
fi

echo
if [ "$FAIL" -eq 0 ]; then echo "驗證全部通過"; else echo "有項目失敗"; fi
exit "$FAIL"
