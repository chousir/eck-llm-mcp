apiVersion: apps/v1
kind: Deployment
metadata:
  name: open-webui
  namespace: {{ ai_namespace }}
spec:
  replicas: 1
  # SQLite 在 RWO 本地 PV 上：不可有兩個 pod 同時寫
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: open-webui
  template:
    metadata:
      labels:
        app: open-webui
      annotations:
        checksum/open-webui-secret: "{{ (webui_secret_key ~ webui_admin_password_resolved) | hash('sha256') }}"
    spec:
      tolerations:
{{ ai_tolerations | to_nice_yaml | trim | indent(8, true) }}
      nodeSelector:
        {{ ai_node_label_key }}: "{{ ai_node_label_value }}"
{% if image_pull_secrets | length > 0 %}
      imagePullSecrets:
{% for s in image_pull_secrets %}
        - name: {{ s }}
{% endfor %}
{% endif %}
      containers:
        - name: open-webui
          image: {{ open_webui_image }}
          ports:
            - containerPort: {{ open_webui_container_port }}
          env:
            - name: WEBUI_AUTH
              value: "true"
            # 首次啟動（DB 內尚無使用者）自動建立 admin，並自動關閉開放註冊
            - name: WEBUI_ADMIN_EMAIL
              value: "{{ webui_admin_email }}"
            - name: WEBUI_ADMIN_NAME
              value: "{{ webui_admin_name }}"
            - name: WEBUI_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: open-webui-secret
                  key: WEBUI_ADMIN_PASSWORD
            - name: WEBUI_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: open-webui-secret
                  key: WEBUI_SECRET_KEY
            # air-gap：不連外、不等 api.openai.com 逾時
            - name: OFFLINE_MODE
              value: "true"
            - name: ENABLE_OPENAI_API
              value: "false"
            - name: ENABLE_COMMUNITY_SHARING
              value: "false"
            - name: OLLAMA_BASE_URL
              value: "{{ ollama_internal_url }}"
            - name: DEFAULT_MODELS
              value: "{{ ollama_primary_model }}"
            # 只有本機 Ollama 模型，全體使用者可見
            - name: BYPASS_MODEL_ACCESS_CONTROL
              value: "true"
            - name: DEFAULT_MODEL_PARAMS
              value: {{ webui_default_model_params | to_json | to_json }}
            # 首次啟動寫入 DB；之後要改請到 Admin -> Settings -> Integrations
            - name: TOOL_SERVER_CONNECTIONS
              value: {{ webui_tool_server_connections | to_json | to_json }}
            - name: RAG_EMBEDDING_ENGINE
              value: "ollama"
            - name: RAG_EMBEDDING_MODEL
              value: "{{ ollama_embed_model }}"
            - name: RAG_OLLAMA_BASE_URL
              value: "{{ ollama_internal_url }}"
          startupProbe:
            httpGet:
              path: /health
              port: {{ open_webui_container_port }}
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: {{ open_webui_container_port }}
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              memory: "{{ open_webui_resources_requests_memory }}"
              cpu: "{{ open_webui_resources_requests_cpu }}"
            limits:
              memory: "{{ open_webui_resources_limits_memory }}"
          volumeMounts:
            - name: data
              mountPath: /app/backend/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: openwebui-data
---
apiVersion: v1
kind: Service
metadata:
  name: open-webui
  namespace: {{ ai_namespace }}
{% if open_webui_service_annotations | length > 0 %}
  annotations:
{{ open_webui_service_annotations | to_nice_yaml | trim | indent(4, true) }}
{% endif %}
spec:
  type: {{ open_webui_service_type }}
  selector:
    app: open-webui
  ports:
    - port: {{ open_webui_service_port }}
      targetPort: {{ open_webui_container_port }}
