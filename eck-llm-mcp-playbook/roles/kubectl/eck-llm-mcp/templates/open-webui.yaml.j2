apiVersion: apps/v1
kind: Deployment
metadata:
  name: open-webui
  namespace: {{ ai_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: open-webui
  template:
    metadata:
      labels:
        app: open-webui
    spec:
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          effect: NoSchedule
      nodeSelector:
        {{ ai_node_label_key }}: "{{ ai_node_label_value }}"
      containers:
        - name: open-webui
          image: {{ open_webui_image }}
          ports:
            - containerPort: {{ open_webui_service_port }}
          env:
            - name: OLLAMA_BASE_URL
              value: "http://ollama.{{ ai_namespace }}.svc:{{ ollama_service_port }}"
            - name: WEBUI_AUTH
              value: "true"
            - name: ENABLE_SIGNUP
              value: "{{ webui_enable_signup }}"
            - name: WEBUI_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: open-webui-secret
                  key: WEBUI_SECRET_KEY
            - name: RAG_EMBEDDING_ENGINE
              value: "ollama"
            - name: RAG_EMBEDDING_MODEL
              value: "{{ ollama_embed_model_name }}"
            - name: RAG_OLLAMA_BASE_URL
              value: "http://ollama.{{ ai_namespace }}.svc:{{ ollama_service_port }}"
          resources:
            requests:
              memory: "{{ open_webui_resources_requests_memory }}"
              cpu: "{{ open_webui_resources_requests_cpu }}"
            limits:
              memory: "{{ open_webui_resources_limits_memory }}"
          volumeMounts:
            - name: data
              mountPath: /app/backend/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: openwebui-data
---
apiVersion: v1
kind: Service
metadata:
  name: open-webui
  namespace: {{ ai_namespace }}
spec:
  type: {{ open_webui_service_type }}
  selector:
    app: open-webui
  ports:
    - port: 80
      targetPort: {{ open_webui_service_port }}
